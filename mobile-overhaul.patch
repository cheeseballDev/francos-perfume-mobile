@@ -0,0 +1,62 @@
+package com.example.francosperfumemobile.helpers;
+
+import android.content.Context;
+import android.util.TypedValue;
+
+import androidx.annotation.Nullable;
+
+import com.example.francosperfumemobile.R;
+import com.google.android.material.button.MaterialButton;
+import com.google.android.material.progressindicator.CircularProgressIndicatorSpec;
+import com.google.android.material.progressindicator.IndeterminateDrawable;
+
+/**
+ * Shows a small spinner inside a button and disables it while a call runs, like the
+ * website's buttons ("Sending code..." with a spinning Loader2). Also stops double taps.
+ */
+public final class ButtonLoading {
+
+    private static final int TAG_IDLE_TEXT = R.id.tag_button_idle_text;
+    private static final int TAG_IDLE_ICON = R.id.tag_button_idle_icon;
+
+    private ButtonLoading() {
+    }
+
+    public static void start(@Nullable MaterialButton button, @Nullable CharSequence loadingText) {
+        if (button == null) return;
+        if (button.getTag(TAG_IDLE_TEXT) == null) {
+            button.setTag(TAG_IDLE_TEXT, button.getText());
+            button.setTag(TAG_IDLE_ICON, button.getIcon() == null ? "none" : button.getIcon());
+        }
+        Context context = button.getContext();
+        CircularProgressIndicatorSpec spec = new CircularProgressIndicatorSpec(context, null, 0, R.style.Widget_FP_Progress_Small);
+        spec.indicatorSize = dp(context, 18);
+        spec.trackThickness = dp(context, 2);
+        spec.indicatorColors = new int[]{button.getCurrentTextColor()};
+        IndeterminateDrawable<CircularProgressIndicatorSpec> spinner = IndeterminateDrawable.createCircularDrawable(context, spec);
+
+        button.setIcon(spinner);
+        button.setIconGravity(MaterialButton.ICON_GRAVITY_TEXT_START);
+        if (loadingText != null) button.setText(loadingText);
+        button.setEnabled(false);
+    }
+
+    public static void stop(@Nullable MaterialButton button) {
+        if (button == null) return;
+        Object idleText = button.getTag(TAG_IDLE_TEXT);
+        Object idleIcon = button.getTag(TAG_IDLE_ICON);
+        if (idleText instanceof CharSequence) button.setText((CharSequence) idleText);
+        button.setIcon(idleIcon instanceof android.graphics.drawable.Drawable ? (android.graphics.drawable.Drawable) idleIcon : null);
+        button.setTag(TAG_IDLE_TEXT, null);
+        button.setTag(TAG_IDLE_ICON, null);
+        button.setEnabled(true);
+    }
+
+    public static boolean isLoading(@Nullable MaterialButton button) {
+        return button != null && button.getTag(TAG_IDLE_TEXT) != null;
+    }
+
+    private static int dp(Context context, float value) {
+        return Math.round(TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, value, context.getResources().getDisplayMetrics()));
+    }
+}
diff --git a/app/src/main/java/com/example/francosperfumemobile/helpers/DateUtils.java b/app/src/main/java/com/example/francosperfumemobile/helpers/DateUtils.java
new file mode 100644
index 0000000..c98e026
--- /dev/null
+++ b/app/src/main/java/com/example/francosperfumemobile/helpers/DateUtils.java
@@ -0,0 +1,121 @@
+package com.example.francosperfumemobile.helpers;
+
+import androidx.annotation.Nullable;
+
+import java.text.ParseException;
+import java.text.SimpleDateFormat;
+import java.util.Calendar;
+import java.util.Date;
+import java.util.Locale;
+import java.util.TimeZone;
+
+/**
+ * Date helpers that work on API 24 (no java.time).
+ * The backend sends ISO strings like "2026-10-26T10:11:34.269Z" or "2026-10-26T10:11:34".
+ * A string without a zone is treated as UTC, which is what the backend stores (DateTime.UtcNow).
+ */
+public final class DateUtils {
+
+    private DateUtils() {
+    }
+
+    @Nullable
+    public static Date parse(@Nullable String iso) {
+        if (iso == null) return null;
+        String s = iso.trim();
+        if (s.isEmpty()) return null;
+
+        try {
+            if (s.length() == 10) { // yyyy-MM-dd
+                SimpleDateFormat day = new SimpleDateFormat("yyyy-MM-dd", Locale.US);
+                day.setTimeZone(TimeZone.getDefault());
+                return day.parse(s);
+            }
+
+            s = s.replace(' ', 'T');
+            // Drop fractional seconds: 10:11:34.2690000 → 10:11:34
+            s = s.replaceAll("(T\\d{2}:\\d{2}:\\d{2})\\.\\d+", "$1");
+
+            String zone = "+0000";
+            if (s.endsWith("Z") || s.endsWith("z")) {
+                s = s.substring(0, s.length() - 1);
+            } else if (s.matches(".*T\\d{2}:\\d{2}(:\\d{2})?[+-]\\d{2}:?\\d{2}$")) {
+                int idx = Math.max(s.lastIndexOf('+'), s.lastIndexOf('-'));
+                zone = s.substring(idx).replace(":", "");
+                s = s.substring(0, idx);
+            }
+            if (s.matches(".*T\\d{2}:\\d{2}$")) s = s + ":00";
+
+            SimpleDateFormat format = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ssZ", Locale.US);
+            return format.parse(s + zone);
+        } catch (ParseException | IndexOutOfBoundsException e) {
+            return null;
+        }
+    }
+
+    /** "Oct 26, 2026", or the raw text if it can't be read. */
+    public static String formatDate(@Nullable String iso) {
+        Date date = parse(iso);
+        if (date == null) return iso == null || iso.isEmpty() ? "—" : iso;
+        return new SimpleDateFormat("MMM d, yyyy", Locale.getDefault()).format(date);
+    }
+
+    /** "Oct 26, 2026 · 6:11 PM" */
+    public static String formatDateTime(@Nullable String iso) {
+        Date date = parse(iso);
+        if (date == null) return iso == null || iso.isEmpty() ? "—" : iso;
+        return new SimpleDateFormat("MMM d, yyyy · h:mm a", Locale.getDefault()).format(date);
+    }
+
+    /** "Just now", "5m ago", "3h ago", "Yesterday", or a date. Used in notifications. */
+    public static String relative(@Nullable String iso) {
+        Date date = parse(iso);
+        if (date == null) return iso == null ? "" : iso;
+        long diff = System.currentTimeMillis() - date.getTime();
+        long minutes = diff / 60000L;
+        if (minutes < 1) return "Just now";
+        if (minutes < 60) return minutes + "m ago";
+        long hours = minutes / 60;
+        if (hours < 24) return hours + "h ago";
+        if (hours < 48) return "Yesterday";
+        long days = hours / 24;
+        if (days < 7) return days + "d ago";
+        return new SimpleDateFormat("MMM d", Locale.getDefault()).format(date);
+    }
+
+    /** yyyy-MM-dd for a date the user picked (month is 0-based like Calendar). */
+    public static String toIsoDay(int year, int month, int day) {
+        return String.format(Locale.US, "%04d-%02d-%02d", year, month + 1, day);
+    }
+
+    /**
+     * Picked day as an ISO UTC timestamp for the backend, e.g. "2027-01-31T12:00:00Z".
+     * Noon (not midnight) so the day stays the same when shown in any time zone.
+     */
+    public static String toIsoUtcDate(int year, int month, int day) {
+        return toIsoDay(year, month, day) + "T12:00:00Z";
+    }
+
+    /** yyyy-MM-dd of a date in the phone's time zone. */
+    public static String formatIsoDay(Date date) {
+        return new SimpleDateFormat("yyyy-MM-dd", Locale.US).format(date);
+    }
+
+    /** Calendar for an ISO string, or null. */
+    @Nullable
+    public static Calendar toCalendar(@Nullable String iso) {
+        Date date = parse(iso);
+        if (date == null) return null;
+        Calendar calendar = Calendar.getInstance();
+        calendar.setTime(date);
+        return calendar;
+    }
+
+    /** Good morning / afternoon / evening, for the dashboard greeting. */
+    public static String greeting() {
+        int hour = Calendar.getInstance().get(Calendar.HOUR_OF_DAY);
+        if (hour < 12) return "Good morning";
+        if (hour < 18) return "Good afternoon";
+        return "Good evening";
+    }
+}
diff --git a/app/src/main/java/com/example/francosperfumemobile/helpers/DebouncedTextWatcher.java b/app/src/main/java/com/example/francosperfumemobile/helpers/DebouncedTextWatcher.java
new file mode 100644
index 0000000..010fc87
--- /dev/null
+++ b/app/src/main/java/com/example/francosperfumemobile/helpers/DebouncedTextWatcher.java
@@ -0,0 +1,75 @@
+package com.example.francosperfumemobile.helpers;
+
+import android.os.Handler;
+import android.os.Looper;
+import android.text.Editable;
+import android.text.TextWatcher;
+
+/**
+ * Waits until the user stops typing before searching, so one search runs
+ * instead of one per key press (website: the search bar's debounce).
+ */
+public class DebouncedTextWatcher implements TextWatcher {
+
+    public interface OnQueryChanged {
+        void onQueryChanged(String query);
+    }
+
+    public static final long DEFAULT_DELAY_MS = 400;
+
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final long delayMs;
+    private final OnQueryChanged listener;
+    private String lastQuery = null;
+    private Runnable pending;
+
+    public DebouncedTextWatcher(OnQueryChanged listener) {
+        this(DEFAULT_DELAY_MS, listener);
+    }
+
+    public DebouncedTextWatcher(long delayMs, OnQueryChanged listener) {
+        this.delayMs = delayMs;
+        this.listener = listener;
+    }
+
+    @Override
+    public void beforeTextChanged(CharSequence s, int start, int count, int after) {
+    }
+
+    @Override
+    public void onTextChanged(CharSequence s, int start, int before, int count) {
+    }
+
+    @Override
+    public void afterTextChanged(Editable s) {
+        final String query = s.toString().trim();
+        if (pending != null) handler.removeCallbacks(pending);
+        pending = () -> {
+            if (query.equals(lastQuery)) return;
+            lastQuery = query;
+            listener.onQueryChanged(query);
+        };
+        handler.postDelayed(pending, delayMs);
+    }
+
+    /** Call from onDestroyView so a late search doesn't run on a closed screen. */
+    public void cancel() {
+        if (pending != null) handler.removeCallbacks(pending);
+    }
+
+    /** Lets the watcher know the current query so the first identical text doesn't search again. */
+    public void setLastQuery(String query) {
+        this.lastQuery = query;
+    }
+
+    /** TextWatcher with only afterTextChanged, to keep listeners short. */
+    public abstract static class Simple implements TextWatcher {
+        @Override
+        public void beforeTextChanged(CharSequence s, int start, int count, int after) {
+        }
+
+        @Override
+        public void onTextChanged(CharSequence s, int start, int before, int count) {
+        }
+    }
+}
