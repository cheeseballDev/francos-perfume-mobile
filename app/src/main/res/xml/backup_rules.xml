<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower (allowBackup is false in the manifest, this is a
   second safety net). The login session must never be backed up.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="francos_perfume_session.xml" />
</full-backup-content>
