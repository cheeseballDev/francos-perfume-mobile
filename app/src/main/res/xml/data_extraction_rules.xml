<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the login session out of cloud backups and phone-to-phone transfers -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="francos_perfume_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="francos_perfume_session.xml" />
    </device-transfer>
</data-extraction-rules>
