<?xml version="1.0" encoding="utf-8"?>
<!-- Request message (website: request message dialog) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

<com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_message" />
            </FrameLayout>

            <TextView
                android:id="@+id/text_dialog_title"
                style="@style/Text.FP.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/message_text" />

            <ImageButton
                android:id="@+id/button_icon_close"
                style="@style/Widget.FP.IconButton"
                android:contentDescription="@string/close_text"
                android:src="@drawable/ic_x" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_dialog_content"
            style="@style/Text.FP.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel_muted"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:textIsSelectable="true"
            tools:text="Please send 20 bottles before the weekend sale." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_close"
            style="@style/Widget.FP.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/close_text" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
</FrameLayout>
