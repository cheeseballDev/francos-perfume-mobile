<?xml version="1.0" encoding="utf-8"?>
<!-- Label over value, used in the detail summaries -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/text_view_info_label"
        style="@style/Text.FP.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="From branch" />

    <TextView
        android:id="@+id/text_view_info_value"
        style="@style/Text.FP.Value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        tools:text="Sta. Lucia" />
</LinearLayout>
