<?xml version="1.0" encoding="utf-8"?>
<!-- Forgot password, step 2: the 6-digit code -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Text.FP.Value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/label_code" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_layout_forgot_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_forgot_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="smsOTPCode"
            android:gravity="center"
            android:hint="@string/hint_code"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:letterSpacing="0.6"
            android:maxLength="6"
            android:maxLines="1"
            android:textSize="24sp"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/text_view_forgot_code_error"
        style="@style/Text.FP.Error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:visibility="gone"
        tools:text="Invalid or expired code"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_verify_reset_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:enabled="false"
        android:text="@string/verify_code" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Text.FP.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/code_not_received" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_resend_reset_code"
            style="@style/Widget.FP.Button.Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resend_code" />
    </LinearLayout>
</LinearLayout>
