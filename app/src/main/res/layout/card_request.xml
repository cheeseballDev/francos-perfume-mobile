<?xml version="1.0" encoding="utf-8"?>
<!-- Request row (website: RequestTable row) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_view_request_id"
                style="@style/Text.FP.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="REQ-0012" />

            <TextView
                android:id="@+id/text_view_request_direction"
                style="@style/Widget.FP.StatusBadge"
                android:layout_marginStart="8dp"
                tools:text="Inbound" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/text_view_request_status"
                style="@style/Widget.FP.StatusBadge"
                tools:text="Pending" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_view_request_from_branch"
                style="@style/Text.FP.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Sta. Lucia" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/fp_muted_foreground" />

            <TextView
                android:id="@+id/text_view_request_to_branch"
                style="@style/Text.FP.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                tools:text="Riverbanks" />
        </LinearLayout>

        <View
            style="@style/Widget.FP.Divider"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_view_request_stage"
                style="@style/Text.FP.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="6dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                app:drawableStartCompat="@drawable/ic_clock"
                app:drawableTint="@color/fp_muted_foreground"
                tools:text="Owner review" />

            <TextView
                android:id="@+id/text_view_request_unit_count"
                style="@style/Text.FP.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                app:drawableStartCompat="@drawable/ic_package"
                app:drawableTint="@color/fp_muted_foreground"
                tools:text="3 items" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_view_request_date"
                style="@style/Text.FP.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                app:drawableStartCompat="@drawable/ic_calendar"
                app:drawableTint="@color/fp_muted_foreground"
                tools:text="Oct 26, 2026" />

            <TextView
                android:id="@+id/text_view_request_delivery_id"
                style="@style/Text.FP.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                app:drawableStartCompat="@drawable/ic_truck"
                app:drawableTint="@color/fp_muted_foreground"
                tools:text="DEL-0003" />
        </LinearLayout>

        <!-- Kept for older code; same as unit count -->
        <TextView
            android:id="@+id/text_view_request_batch_count"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
