<?xml version="1.0" encoding="utf-8"?>
<!-- Delivery item, read only -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_panel_muted"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_tile"
        android:backgroundTint="@color/fp_card">

        <ImageView
            android:id="@+id/image_view_delivery_outbound_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_package" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_view_delivery_outbound_product_name"
            style="@style/Text.FP.Value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="Bleu de Franco" />

        <TextView
            android:id="@+id/text_view_delivery_outbound_product_id"
            style="@style/Text.FP.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Product #12" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_view_delivery_outbound_unit_count"
            style="@style/Text.FP.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="20 units" />

        <TextView
            android:id="@+id/text_view_delivery_outbound_status"
            style="@style/Widget.FP.StatusBadge"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            tools:text="Received"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
