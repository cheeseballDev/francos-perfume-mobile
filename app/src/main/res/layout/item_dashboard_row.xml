<?xml version="1.0" encoding="utf-8"?>
<!-- A row inside a dashboard panel (website: RequestItem / DeliveryItem) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_panel_muted"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_view_row_title"
            style="@style/Text.FP.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="REQ-0012" />

        <TextView
            android:id="@+id/text_view_row_subtitle"
            style="@style/Text.FP.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone"
            tools:text="Sta. Lucia → Riverbanks"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_view_row_badge"
        style="@style/Widget.FP.StatusBadge"
        android:layout_marginStart="8dp"
        android:visibility="gone"
        tools:text="Pending"
        tools:visibility="visible" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/fp_muted_foreground" />
</LinearLayout>
