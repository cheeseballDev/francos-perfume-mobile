<?xml version="1.0" encoding="utf-8"?>
<!-- "Nothing here" message for lists -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_empty_state"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone"
    tools:visibility="visible">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_icon_tile">

        <ImageView
            android:id="@+id/image_view_empty_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_inbox"
            app:tint="@color/fp_muted_foreground" />
    </FrameLayout>

    <TextView
        android:id="@+id/text_view_empty_title"
        style="@style/Text.FP.SectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/empty_title" />

    <TextView
        android:id="@+id/text_view_empty_message"
        style="@style/Text.FP.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/empty_message_filters" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_empty_retry"
        style="@style/Widget.FP.Button.Outlined.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/try_again"
        android:visibility="gone"
        app:icon="@drawable/ic_refresh" />
</LinearLayout>
