<?xml version="1.0" encoding="utf-8"?>
<!-- Forgot password: email → 6-digit code → new password (website: ForgotPasswordPage) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/forgot_password"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fp_background"
    tools:context=".activities.ForgotPasswordActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/bg_auth_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_forgot_back"
                    style="@style/Widget.FP.IconButton"
                    android:layout_marginStart="-10dp"
                    android:contentDescription="@string/go_back_text"
                    android:src="@drawable/ic_arrow_left" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/text_view_forgot_step"
                    style="@style/Text.FP.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Step 1 of 3" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_forgot_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="3"
                android:progress="1"
                app:indicatorColor="@color/fp_foreground"
                app:trackColor="@color/fp_border"
                app:trackCornerRadius="2dp"
                app:trackThickness="4dp" />

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_icon_tile"
                android:backgroundTint="@color/fp_primary">

                <ImageView
                    android:id="@+id/image_view_forgot_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mail"
                    app:tint="@color/fp_on_primary" />
            </FrameLayout>

            <TextView
                style="@style/Text.FP.PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/forgot_password" />

            <TextView
                android:id="@+id/text_view_forgot_subtitle"
                style="@style/Text.FP.PageSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/forgot_subtitle_email" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp">

                <ViewFlipper
                    android:id="@+id/view_flipper_forgot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inAnimation="@android:anim/fade_in"
                    android:measureAllChildren="false"
                    android:outAnimation="@android:anim/fade_out"
                    android:padding="20dp">

                    <include
                        android:id="@+id/step_email"
                        layout="@layout/layout_forgot_email" />

                    <include
                        android:id="@+id/step_code"
                        layout="@layout/layout_forgot_code" />

                    <include
                        android:id="@+id/step_new_password"
                        layout="@layout/layout_forgot_new_password" />
                </ViewFlipper>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_back_to_login"
                style="@style/Widget.FP.Button.Text.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="@string/back_to_login"
                app:icon="@drawable/ic_arrow_left" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
