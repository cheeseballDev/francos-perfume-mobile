<?xml version="1.0" encoding="utf-8"?>
<!-- Delivery details + receive form (website: DeliveryDetailsPage / DeliveryConfirmationPage) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerlayout_delivery_details"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fp_background"
    android:orientation="vertical"
    tools:context=".activities.DeliveryDetailsActivity">

    <include
        android:id="@+id/top_navigation_bar_delivery_confirmation"
        layout="@layout/top_bar_detail" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_delivery_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_delivery_details"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:visibility="invisible"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Summary -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/text_view_delivery_details_id"
                                    style="@style/Text.FP.SectionTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="20sp"
                                    tools:text="DEL-0003" />

                                <TextView
                                    android:id="@+id/text_view_delivery_details_direction"
                                    style="@style/Widget.FP.StatusBadge"
                                    android:layout_marginStart="8dp"
                                    tools:text="Inbound" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <TextView
                                    android:id="@+id/text_view_delivery_details_status"
                                    style="@style/Widget.FP.StatusBadge"
                                    tools:text="In transit" />
                            </LinearLayout>

                            <View
                                style="@style/Widget.FP.Divider"
                                android:layout_marginTop="14dp"
                                android:layout_marginBottom="8dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <include
                                    android:id="@+id/info_delivery_from"
                                    layout="@layout/item_info_row" />

                                <include
                                    android:id="@+id/info_delivery_to"
                                    layout="@layout/item_info_row" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <include
                                    android:id="@+id/info_delivery_created_by"
                                    layout="@layout/item_info_row" />

                                <include
                                    android:id="@+id/info_delivery_date"
                                    layout="@layout/item_info_row" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <include
                                    android:id="@+id/info_delivery_products"
                                    layout="@layout/item_info_row" />

                                <include
                                    android:id="@+id/info_delivery_units"
                                    layout="@layout/item_info_row" />
                            </LinearLayout>

                            <!-- Old IDs, still filled in -->
                            <TextView
                                android:id="@+id/text_view_delivery_details_date_submitted"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/text_view_delivery_details_from_branch"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/text_view_delivery_details_to_branch"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/text_view_delivery_details_created_by"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Receive: expiry date (was hard-coded to 2026-12-31) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_receive_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                style="@style/Text.FP.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/receive_title" />

                            <TextView
                                style="@style/Text.FP.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/receive_subtitle" />

                            <TextView
                                style="@style/Text.FP.Value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:layout_marginBottom="6dp"
                                android:text="@string/label_expiry_date" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/text_input_layout_expiry_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:endIconDrawable="@drawable/ic_calendar"
                                app:endIconMode="custom"
                                app:helperText="@string/expiry_helper"
                                app:hintEnabled="false">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edit_text_expiry_date"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:cursorVisible="false"
                                    android:focusable="false"
                                    android:hint="@string/hint_pick_date"
                                    android:inputType="none" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Items -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/text_view_delivery_details_title_recycler"
                                style="@style/Text.FP.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/delivery_items_title" />

                            <TextView
                                android:id="@+id/text_view_delivery_items_hint"
                                style="@style/Text.FP.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:visibility="gone"
                                tools:text="Untick missing items or lower the quantity, then pick a reason."
                                tools:visibility="visible" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recycler_view_delivery_items"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:nestedScrollingEnabled="false"
                                tools:itemCount="2"
                                tools:listitem="@layout/card_delivery_outbound_items" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Nothing to do (website: "No Action Required") -->
                    <TextView
                        android:id="@+id/text_view_delivery_no_action"
                        style="@style/Text.FP.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_panel_muted"
                        android:gravity="center"
                        android:padding="14dp"
                        android:visibility="gone"
                        tools:text="No action required. This delivery is completed."
                        tools:visibility="visible" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_bar_delivery_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />

        <include
            android:id="@+id/layout_empty_delivery_details"
            layout="@layout/view_empty_state" />
    </FrameLayout>

    <!-- Actions: only what is possible for this delivery's status and your branch -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_border"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/text_view_delivery_actions_hint"
            style="@style/Text.FP.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            tools:text="Mark as in transit to notify the receiving branch." />

        <LinearLayout
            android:id="@+id/layout_outbound_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_cancel_request"
                style="@style/Widget.FP.Button.Outlined.Destructive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/cancel_delivery"
                app:icon="@drawable/ic_circle_x"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_mark_in_transit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/mark_in_transit"
                app:icon="@drawable/ic_truck"
                app:iconGravity="textStart" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_inbound_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_confirm_delivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/confirm_delivery"
                app:icon="@drawable/ic_circle_check"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
