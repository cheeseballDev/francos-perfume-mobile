<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.InventoryFragment">

    <EditText
        android:id="@+id/textfield_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/text_field_design"
        android:ems="10"
        android:hint="@string/hint_request_search"
        android:inputType="text"
        android:minHeight="48dp"
        android:padding="10dp"
        android:textSize="@dimen/font_m"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"

        app:layout_constraintTop_toBottomOf="@+id/textfield_search"
        app:layout_constraintStart_toStartOf="@id/textfield_search"
        app:layout_constraintEnd_toEndOf="@id/textfield_search"
        >

        <Spinner
            android:id="@+id/dropdown_from_branch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/dropdown_design"
            android:minHeight="48dp" />

        <Spinner
            android:id="@+id/dropdown_to_branch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/dropdown_design"
            android:minHeight="48dp" />

        <Spinner
            android:id="@+id/dropdown_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/dropdown_design"
            android:minHeight="48dp" />

    </LinearLayout>


    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/request_toggle_button_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:spacing="2dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/button_request_all"
        app:layout_constraintEnd_toEndOf="@+id/linearLayout2"
        app:layout_constraintStart_toStartOf="@id/linearLayout2"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_request_inbound"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/inbound_text"
            app:cornerRadius="8dp"
            android:textColor="@color/text_filter_color"
            android:backgroundTint="@color/button_filter_color"
            app:strokeColor="@color/stroke_filter_color"
            app:strokeWidth="1dp"

            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_request_outbound"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/outbound_text"
            app:cornerRadius="8dp"
            android:textColor="@color/text_filter_color"
            android:backgroundTint="@color/button_filter_color"
            app:strokeColor="@color/stroke_filter_color"
            app:strokeWidth="1dp"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_request_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/all_requests_text"
            app:cornerRadius="8dp"
            android:textColor="@color/text_filter_color"
            android:backgroundTint="@color/button_filter_color"
            app:strokeColor="@color/stroke_filter_color"
            app:strokeWidth="2dp"

            />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_delivery"
        android:layout_width="0dp"
        android:layout_height="500dp"
        app:layout_constraintEnd_toEndOf="@+id/linearLayout2"
        app:layout_constraintStart_toStartOf="@+id/linearLayout2"
        app:layout_constraintTop_toBottomOf="@+id/request_toggle_button_group"
        tools:listitem="@layout/card_delivery" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recycler_view_delivery">


        <ImageButton
            android:id="@+id/button_last_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:backgroundTint="@color/transparent"
            android:src="@drawable/icon_chevron_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_request_pagination"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pagination_sample_text"
            android:textSize="@dimen/font_m"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/button_next_page"
            app:layout_constraintStart_toEndOf="@+id/button_last_page"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/button_next_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:backgroundTint="@color/transparent"
            android:src="@drawable/icon_chevron_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>