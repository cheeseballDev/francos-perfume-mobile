<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fp_background"
    tools:context=".fragments.DashboardFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.example.francosperfumemobile.components.DashboardCardView
                    android:id="@+id/dashboard_inventory_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <com.example.francosperfumemobile.components.DashboardCardView
                    android:id="@+id/dashboard_requests_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.example.francosperfumemobile.components.DashboardCardView
                    android:id="@+id/dashboard_dispatch_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <com.example.francosperfumemobile.components.DashboardCardView
                    android:id="@+id/dashboard_delivery_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <include
                android:id="@+id/panel_pending_requests"
                layout="@layout/view_dashboard_panel" />

            <include
                android:id="@+id/panel_pending_deliveries"
                layout="@layout/view_dashboard_panel" />

            <include
                android:id="@+id/panel_low_stock"
                layout="@layout/view_dashboard_panel" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
