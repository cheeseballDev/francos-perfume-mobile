<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/image_view_timeline_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/icon_approved"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_view_timeline_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/timeline_step_text"
            android:textSize="@dimen/font_m"
            app:layout_constraintStart_toEndOf="@+id/image_view_timeline_icon"
            app:layout_constraintTop_toTopOf="@+id/image_view_timeline_icon" />

        <TextView
            android:id="@+id/text_view_timeline_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:text="@string/timeline_subtitle_text"
            android:textSize="@dimen/font_s"
            app:layout_constraintStart_toStartOf="@+id/text_view_timeline_title"
            app:layout_constraintTop_toBottomOf="@+id/text_view_timeline_title" />

        <View
            android:id="@+id/line_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/dashed_line"
            android:layerType="software"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/image_view_timeline_icon"
            app:layout_constraintStart_toStartOf="@+id/image_view_timeline_icon"
            app:layout_constraintTop_toBottomOf="@+id/image_view_timeline_icon" />

        <TextView
            android:id="@+id/text_view_timeline_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:background="@drawable/badge_design"
            android:backgroundTint="@color/darker_blue"
            android:padding="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/request_sample_status"
            android:textColor="@color/blue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>