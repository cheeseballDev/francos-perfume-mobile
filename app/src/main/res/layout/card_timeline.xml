<?xml version="1.0" encoding="utf-8"?>
<!-- One approval / delivery step (website: RequestTimeline) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/layout_timeline_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_icon_tile">

            <ImageView
                android:id="@+id/image_view_timeline_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_clock" />
        </FrameLayout>

        <View
            android:id="@+id/line_top"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_timeline_line"
            android:minHeight="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="30dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_view_timeline_title"
                style="@style/Text.FP.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Owner" />

            <TextView
                android:id="@+id/text_view_timeline_status"
                style="@style/Widget.FP.StatusBadge"
                android:layout_marginStart="8dp"
                tools:text="Approved" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_view_timeline_subtitle"
            style="@style/Text.FP.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Approved by: Maria Cruz" />

        <TextView
            android:id="@+id/text_view_timeline_remarks"
            style="@style/Text.FP.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            tools:text="“Please send before Friday.”"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/text_view_timeline_date"
            style="@style/Text.FP.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            tools:text="Oct 26, 2026 · 6:11 PM"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
