<?xml version="1.0" encoding="utf-8"?>
<!-- Inventory row (website: InventoryTable row) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image_view_inventory_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@color/fp_muted"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/francos_perfume_logo"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.FP.Medium" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_view_inventory_product_name"
                style="@style/Text.FP.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Bleu de Franco" />

            <TextView
                android:id="@+id/text_view_inventory_product_id"
                style="@style/Text.FP.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="PROD-001" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_view_inventory_branch_location"
                    style="@style/Widget.FP.StatusBadge"
                    android:layout_marginEnd="6dp"
                    tools:text="Sta. Lucia" />

                <TextView
                    android:id="@+id/text_view_inventory_product_type"
                    style="@style/Widget.FP.StatusBadge"
                    android:layout_marginEnd="6dp"
                    tools:text="Premium" />

                <TextView
                    android:id="@+id/text_view_inventory_gender_type"
                    style="@style/Widget.FP.StatusBadge"
                    tools:text="Unisex" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_view_inventory_stock_badge"
                style="@style/Widget.FP.StatusBadge"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                tools:text="Low stock"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_view_inventory_unit_count"
                style="@style/Text.FP.Metric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                tools:text="128" />

            <TextView
                style="@style/Text.FP.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/units_label" />

            <TextView
                android:id="@+id/text_view_inventory_batch_count"
                style="@style/Text.FP.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="5 batches" />
        </LinearLayout>

        <ImageView
            android:id="@+id/button_inventory_view_product"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/fp_muted_foreground" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
