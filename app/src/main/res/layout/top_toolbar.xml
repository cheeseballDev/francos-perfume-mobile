<?xml version="1.0" encoding="utf-8"?>
<!-- Top bar for the main tabs: menu, logo + title, notifications with unread badge -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_border"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <ImageButton
        android:id="@+id/button_menu"
        style="@style/Widget.FP.IconButton"
        android:contentDescription="@string/cd_open_menu"
        android:src="@drawable/ic_menu" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/image_view_logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:importantForAccessibility="no"
            android:src="@drawable/francos_perfume_logo" />

        <TextView
            android:id="@+id/text_view_toolbar_title"
            style="@style/Text.FP.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/title" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/button_notification"
            style="@style/Widget.FP.IconButton"
            android:contentDescription="@string/cd_notifications"
            android:src="@drawable/ic_bell" />

        <TextView
            android:id="@+id/text_view_notification_badge"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_badge_count"
            android:fontFamily="@font/montserrat"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:minWidth="18dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/fp_on_destructive"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="3"
            tools:visibility="visible" />
    </FrameLayout>
</LinearLayout>
