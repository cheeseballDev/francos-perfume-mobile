<?xml version="1.0" encoding="utf-8"?>
<!-- Batches of one product at one branch (website: InventoryTable expanded row) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerlayout_inventory_batch_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fp_background"
    android:orientation="vertical"
    tools:context=".activities.InventoryBatchListActivity">

    <include
        android:id="@+id/top_navigation_bar_inventory_batch"
        layout="@layout/top_bar_detail" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_batches"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- First row is the product summary (header_batch_list), then one card per batch -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_batch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                tools:listitem="@layout/card_batches" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <include
            android:id="@+id/layout_empty_batches"
            layout="@layout/view_empty_state" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_bar_batches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
