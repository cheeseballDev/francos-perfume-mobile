<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/edit_batch_colon_text"
        android:textSize="@dimen/font_xl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/button_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:backgroundTint="@color/transparent"
        android:importantForAccessibility="no"
        android:src="@drawable/icon_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alignmentMode="alignBounds"
        android:columnCount="2"
        android:padding="16dp"
        android:useDefaultMargins="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_close">
        <!-- Row 1: Selected Perfume -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginTop="8dp"
            android:text="@string/selected_perfume_text"
            android:textColor="#888888"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_selected_perfume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal|center_vertical"
            android:text="@string/inventory_sample_name"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Row 2: Target Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:text="Target Date:"
            android:textColor="#888888"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/text_target_date"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal|center_vertical"
            android:background="@drawable/text_field_design"
            android:clickable="true"
            android:drawableEnd="@drawable/icon_edit_calendar"
            android:focusable="true"
            android:hint="@string/hint_date"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <!-- Row 3: Stock Adjustment -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:text="@string/stock_adjustment_text"
            android:textColor="#888888"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/button_plus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@color/yellow_primary"
                android:src="@drawable/icon_plus" />

            <EditText
                android:id="@+id/text_stock_quantity"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/text_field_design"
                android:gravity="center"
                android:hint="@string/quantity_sample"
                android:inputType="number"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/button_minus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@color/yellow_primary"
                android:src="@drawable/icon_minus" />
        </LinearLayout>

        <!-- Row 4: Reason for edit -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:text="@string/reason_for_edit_text"
            android:textColor="#888888"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spinner_reason"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal|center_vertical"
            android:background="@drawable/dropdown_design"
            android:paddingHorizontal="12dp" />

    </GridLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/gridLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:background="@drawable/button_design"
            android:backgroundTint="@color/yellow_primary"
            android:text="@string/save_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gridLayout" />


        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:background="@drawable/button_design"
            android:text="@string/cancel_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gridLayout" />



    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>