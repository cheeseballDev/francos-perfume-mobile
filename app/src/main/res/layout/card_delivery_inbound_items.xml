<?xml version="1.0" encoding="utf-8"?>
<!-- Delivery item while receiving (website: DeliveryConfirmationPage row) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_panel_muted"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/check_box_delivery_inbound_received"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-8dp"
            android:contentDescription="@string/received_question_mark_text"
            android:minWidth="40dp"
            android:minHeight="40dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_view_delivery_inbound_product_name"
                style="@style/Text.FP.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Bleu de Franco" />

            <TextView
                android:id="@+id/text_view_delivery_inbound_product_id"
                style="@style/Text.FP.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Product #12" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.FP.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/requested_qty_text" />

            <TextView
                android:id="@+id/text_view_delivered_requested_quantity"
                style="@style/Text.FP.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="18sp"
                tools:text="20" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <TextView
                style="@style/Text.FP.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/received_quantity_text" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/text_input_layout_received_quantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_text_delivery_inbound_received_quantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_quantity"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="5"
                    android:minHeight="44dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Reason when less arrived than requested (website: REASON_OPTIONS) -->
    <LinearLayout
        android:id="@+id/layout_delivery_inbound_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            style="@style/Text.FP.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remarks_text" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.FP.TextInputLayout.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdown_delivery_inbound_remarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/reason_select"
                android:inputType="none"
                android:minHeight="44dp" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Kept for older code -->
    <EditText
        android:id="@+id/edit_text_delivery_inbound_additional_remarks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAutofill="no"
        android:inputType="none"
        android:visibility="gone" />
</LinearLayout>
