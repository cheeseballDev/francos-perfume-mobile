<?xml version="1.0" encoding="utf-8"?>
<!-- One KPI tile on the dashboard (website: StatusCard) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="128dp"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_view_dashboard_title"
                style="@style/Text.FP.Muted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:maxLines="2"
                android:textStyle="bold"
                android:text="@string/dashboard_title_text" />

            <FrameLayout
                android:id="@+id/layout_dashboard_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:id="@+id/image_view_dashboard_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_boxes" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/text_view_dashboard_value"
            style="@style/Text.FP.Metric"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/placeholder_dash"
            tools:text="1,250" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/text_view_dashboard_warning"
            style="@style/Text.FP.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            tools:text="12 items in low stock" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
