<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.RequestDetailsActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/top_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:contentInsetEnd="0dp"
        app:contentInsetStart="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" >

        <ImageView
            android:id="@+id/button_menu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="16dp"
            android:src="@drawable/icon_menu"
            tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />

        <ImageView
            android:id="@+id/image_view_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/francos_perfume_logo" />

        <ImageView
            android:id="@+id/button_notifcation"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:src="@drawable/icon_notification" />

    </androidx.appcompat.widget.Toolbar>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_go_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/transparent"
        android:text="@string/go_back_text"
        android:textColor="@color/text_secondary"
        app:icon="@drawable/icon_chevron_left"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="24dp"
        app:iconTint="@color/text_secondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_navigation_bar"
        app:srcCompat="@drawable/icon_chevron_left" />

    <TextView
        android:id="@+id/text_view_request_details_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/sample_request_id"
        android:textSize="@dimen/font_l"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_go_back" />

    <TextView
        android:id="@+id/text_view_date_submitted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="@string/sample_date_submitted"
        app:layout_constraintBottom_toBottomOf="@+id/button_go_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/button_go_back" />

    <TextView
        android:id="@+id/text_view_request_stage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_design"
        android:backgroundTint="@color/darker_magenta"
        android:padding="4dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"

        android:text="@string/inbound_text"
        android:textColor="@color/magenta"
        app:layout_constraintBottom_toBottomOf="@+id/text_view_request_details_id"
        app:layout_constraintEnd_toEndOf="@+id/text_view_date_submitted"
        app:layout_constraintTop_toTopOf="@+id/text_view_request_details_id" />


</androidx.constraintlayout.widget.ConstraintLayout>