<?xml version="1.0" encoding="utf-8"?>
<!-- Request details (website: RequestDetailsPage) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerlayout_request_details"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fp_background"
    android:orientation="vertical"
    tools:context=".activities.RequestDetailsActivity">

    <include
        android:id="@+id/top_navigation_bar_request_details"
        layout="@layout/top_bar_detail" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_request_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_request_details"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:visibility="invisible"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Summary -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/text_view_request_details_id"
                                    style="@style/Text.FP.SectionTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="20sp"
                                    tools:text="REQ-0012" />

                                <TextView
                                    android:id="@+id/text_view_request_details_direction"
                                    style="@style/Widget.FP.StatusBadge"
                                    android:layout_marginStart="8dp"
                                    tools:text="Inbound" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <TextView
                                    android:id="@+id/text_view_request_details_status"
                                    style="@style/Widget.FP.StatusBadge"
                                    tools:text="Pending" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/text_view_request_details_stage"
                                style="@style/Text.FP.Muted"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:drawablePadding="6dp"
                                android:gravity="center_vertical"
                                app:drawableStartCompat="@drawable/ic_clock"
                                app:drawableTint="@color/fp_muted_foreground"
                                tools:text="Waiting for: Owner" />

                            <View
                                style="@style/Widget.FP.Divider"
                                android:layout_marginTop="14dp"
                                android:layout_marginBottom="8dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <include
                                    android:id="@+id/info_from_branch"
                                    layout="@layout/item_info_row" />

                                <include
                                    android:id="@+id/info_to_branch"
                                    layout="@layout/item_info_row" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <include
                                    android:id="@+id/info_created_by"
                                    layout="@layout/item_info_row" />

                                <include
                                    android:id="@+id/info_date_submitted"
                                    layout="@layout/item_info_row" />
                            </LinearLayout>

                            <!-- Old IDs, still filled in for anything that reads them -->
                            <TextView
                                android:id="@+id/text_view_request_details_date_submitted"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/text_view_request_details_from_branch"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/text_view_request_details_to_branch"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/text_view_request_details_created_by"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/button_open_message"
                                    style="@style/Widget.FP.Button.Outlined.Small"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/open_message_text"
                                    app:icon="@drawable/ic_message"
                                    app:iconGravity="textStart" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/button_cancel_request"
                                    style="@style/Widget.FP.Button.Outlined.Destructive"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:minHeight="40dp"
                                    android:text="@string/cancel_request"
                                    android:textSize="13sp"
                                    android:visibility="gone"
                                    app:icon="@drawable/ic_circle_x"
                                    app:iconGravity="textStart"
                                    tools:visibility="visible" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Products -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                style="@style/Text.FP.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/requested_products_text" />

                            <TextView
                                android:id="@+id/text_view_requested_products_hint"
                                style="@style/Text.FP.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                tools:text="Untick a product or lower its quantity to approve less." />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recycler_view_requested_products"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:nestedScrollingEnabled="false"
                                tools:itemCount="2"
                                tools:listitem="@layout/card_requested_products" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Timeline -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                style="@style/Text.FP.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="@string/timeline_text" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recycler_view_request_timeline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false"
                                tools:itemCount="3"
                                tools:listitem="@layout/card_timeline" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_bar_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />

        <include
            android:id="@+id/layout_empty_request_details"
            layout="@layout/view_empty_state" />
    </FrameLayout>

    <!-- Approve / reject: only for the person the current stage is waiting for -->
    <LinearLayout
        android:id="@+id/layout_request_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_border"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/text_view_request_actions_hint"
            style="@style/Text.FP.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            tools:text="You are reviewing this request as Owner." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_reject_cancel"
                style="@style/Widget.FP.Button.Outlined.Destructive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/deny_text"
                app:icon="@drawable/ic_x"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_accept"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/approve_text"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
