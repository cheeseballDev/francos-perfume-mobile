<?xml version="1.0" encoding="utf-8"?>
<!-- New transfer request (website: CreateTransferRequestPage) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/create_request_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fp_background"
    android:orientation="vertical"
    tools:context=".activities.CreateRequestActivity">

    <include
        android:id="@+id/top_bar_create_request"
        layout="@layout/top_bar_detail" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Branches -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.FP.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_branches_title" />

                    <TextView
                        style="@style/Text.FP.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/create_from_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/text_input_layout_from_branch"
                        style="@style/Widget.FP.TextInputLayout.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/dropdown_create_from_branch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/create_from_hint"
                            android:inputType="none"
                            android:minHeight="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/Text.FP.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/create_to_label" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/text_input_layout_to_branch"
                        style="@style/Widget.FP.TextInputLayout.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/dropdown_create_to_branch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/create_to_hint"
                            android:inputType="none"
                            android:minHeight="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Add products -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.FP.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_products_title" />

                    <TextView
                        android:id="@+id/text_view_create_products_hint"
                        style="@style/Text.FP.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/create_pick_source_first" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/text_input_layout_product"
                        style="@style/Widget.FP.TextInputLayout.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:enabled="false">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/dropdown_create_product"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/create_product_hint"
                            android:inputType="none"
                            android:minHeight="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_create_minus"
                            style="@style/Widget.FP.Button.Outlined"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:contentDescription="@string/cd_decrease"
                            android:padding="0dp"
                            app:icon="@drawable/ic_minus"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/text_input_layout_create_quantity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_text_create_quantity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="4"
                                android:text="1"
                                android:textStyle="bold" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_create_plus"
                            style="@style/Widget.FP.Button.Outlined"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:contentDescription="@string/cd_increase"
                            android:padding="0dp"
                            app:icon="@drawable/ic_plus"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_view_create_available"
                        style="@style/Text.FP.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:visibility="gone"
                        tools:text="Available at Sta. Lucia: 12"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_create_add_product"
                        style="@style/Widget.FP.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:enabled="false"
                        android:text="@string/create_add_product"
                        app:icon="@drawable/ic_plus"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Products in this request -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.FP.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_lines_title" />

                    <LinearLayout
                        android:id="@+id/layout_create_lines"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/text_view_create_no_lines"
                        style="@style/Text.FP.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="16dp"
                        android:paddingBottom="8dp"
                        android:text="@string/create_no_lines" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Message -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.FP.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_message_title" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/text_input_layout_create_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:counterEnabled="true"
                        app:counterMaxLength="255"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_text_create_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:hint="@string/create_message_hint"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="255"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layout_create_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_border"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_view_create_summary"
                style="@style/Text.FP.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="3 products · 40 units" />

            <TextView
                android:id="@+id/text_view_create_route"
                style="@style/Text.FP.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Warehouse → Sta. Lucia" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_create_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:enabled="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/create_submit" />
    </LinearLayout>
</LinearLayout>
