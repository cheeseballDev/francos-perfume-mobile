<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation drawer (website: Sidebar): who is logged in, shortcuts, logout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/left_drawer_panel"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/fp_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <ImageView
            android:id="@+id/image_view_drawer_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/francos_perfume_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.FP.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title" />

            <TextView
                style="@style/Text.FP.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drawer_tagline" />
        </LinearLayout>
    </LinearLayout>

    <!-- Logged-in user -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_panel_muted"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/text_view_drawer_name"
            style="@style/Text.FP.Value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Kevin Santos" />

        <TextView
            android:id="@+id/text_view_drawer_email"
            style="@style/Text.FP.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="kevin@gmail.com" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_view_drawer_role"
                style="@style/Widget.FP.StatusBadge"
                tools:text="Manager" />

            <TextView
                android:id="@+id/text_view_drawer_branch"
                style="@style/Text.FP.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                app:drawableStartCompat="@drawable/ic_map_pin"
                app:drawableTint="@color/fp_muted_foreground"
                tools:text="Sta. Lucia" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Text.FP.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="6dp"
        android:text="@string/drawer_section_menu" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/drawer_nav_dashboard"
        style="@style/Widget.FP.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:text="@string/dashboard_text"
        app:icon="@drawable/ic_layout_dashboard"
        app:iconPadding="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/drawer_nav_inventory"
        style="@style/Widget.FP.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:text="@string/inventory_text"
        app:icon="@drawable/ic_boxes"
        app:iconPadding="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/drawer_nav_request"
        style="@style/Widget.FP.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:text="@string/requests_text"
        app:icon="@drawable/ic_file_text"
        app:iconPadding="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/drawer_nav_delivery"
        style="@style/Widget.FP.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:text="@string/deliveries_text"
        app:icon="@drawable/ic_truck"
        app:iconPadding="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/drawer_nav_notifications"
        style="@style/Widget.FP.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:text="@string/notifications_title"
        app:icon="@drawable/ic_bell"
        app:iconPadding="14dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        style="@style/Text.FP.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:text="@string/drawer_web_hint" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_logout"
        style="@style/Widget.FP.Button.Outlined.Destructive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/logout_text"
        app:icon="@drawable/ic_logout"
        app:iconGravity="textStart" />
</LinearLayout>
