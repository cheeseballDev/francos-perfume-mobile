<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated by PasswordConditionsView (merge: the view itself is the vertical LinearLayout) -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_muted"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            style="@style/Text.FP.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/pw_rules_title" />

        <LinearLayout
            android:id="@+id/layout_password_condition_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</merge>
